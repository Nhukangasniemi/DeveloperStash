# --- Neon PostgreSQL -------------------------------------------------------
#
# Two connection strings from the SAME Neon branch:
#
# DATABASE_URL — POOLED. Hostname contains "-pooler". Used by the app at
#   runtime through @prisma/adapter-neon. Serverless functions open and drop
#   connections constantly, so they must go through Neon's pooler.
#
# DIRECT_URL   — UNPOOLED. Same host WITHOUT "-pooler". Used only by the
#   Prisma CLI (migrate, db pull). Migrations hold advisory locks and run long
#   sessions, which a transaction pooler cannot support.
#
# Use your Neon *development* branch here. Production gets its own branch and
# its own values set in the hosting provider's dashboard.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/devstash?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/devstash?sslmode=require"
